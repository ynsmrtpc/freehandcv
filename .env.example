DATABASE_URL=postgres://freehandcv:freehandcv@localhost:5433/freehandcv
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google sign-in + One Tap (Google Cloud Console → OAuth client ID, "Web application").
# If empty, Google buttons are hidden; email/password sign-in keeps working.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server PDF. Empty CHROMIUM_PATH = the browser installed by `bunx playwright install chromium`
# (local development); the Docker image sets it to the system Chromium.
CHROMIUM_PATH=
# Where the PDF browser reaches this app; empty = http://localhost:$PORT.
PDF_RENDER_ORIGIN=

# Email (password reset links) through the Resend HTTP API (resend.com → API Keys).
# EMAIL_FROM must use a domain verified in Resend, e.g. "FreehandCV <no-reply@freehandcv.com>".
# If either is empty, nothing is sent: in development the email (with its link) is printed to the
# server console; in production a warning is logged.
RESEND_API_KEY=
EMAIL_FROM=

# Uploaded media (admin > Media). Use an absolute path outside the app folder so files survive
# deploys, e.g. /www/wwwroot/freehandcv-media. Empty = ./storage/media (development).
MEDIA_DIR=

# Optional AI drafting: full OpenAI-compatible chat-completions endpoint, server-only key and model.
# All four are required; without them manual creation stays available and no provider is contacted.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_PROVIDER_NAME=

# Optional read-only GitHub OAuth. No repo/write permissions are requested.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional LinkedIn OpenID Connect account linking.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional Canva Connect API (OAuth 2.0 + PKCE) for importing designs from Canva.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Optional override; defaults to <NEXT_PUBLIC_SITE_URL>/api/canva/callback
CANVA_REDIRECT_URI=

# Optional public-site analytics. Private app/admin/company pages and query strings are excluded.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
