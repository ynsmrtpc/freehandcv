DATABASE_URL=postgres://freehandcv:freehandcv@localhost:5433/freehandcv
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google sign-in + One Tap (Google Cloud Console → OAuth client ID, "Web application").
# If empty, Google buttons are hidden; email/password sign-in keeps working.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server PDF. Empty CHROMIUM_PATH = the browser installed by `pnpm exec playwright install chromium`
# (local development); the Docker image sets it to the system Chromium.
CHROMIUM_PATH=
# Where the PDF browser reaches this app; empty = http://localhost:$PORT.
PDF_RENDER_ORIGIN=
